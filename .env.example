# ──────────────────────────────────────────────────────────────
# Grok2API Server — Cấu hình chung
# ──────────────────────────────────────────────────────────────

# Grok2API Server Admin (dùng trong các script Python)
GROK2API_BASE="http://127.0.0.1:8080"
GROK2API_USER="admin"
GROK2API_PASS="your_admin_password"

# YesCaptcha (bắt buộc cho giải Turnstile CAPTCHA)
YESCAPTCHA_KEY="your_yescaptcha_key"

# Nhà cung cấp Email: gptmail / luckmail / mailnest / tmail / fce / gmail / mailtm / tempmail / guerrilla / outlook
EMAIL_PROVIDER="luckmail"

# ──────────────────────────────────────────────────────────────
# Cấu hình nhà cung cấp Email
# ──────────────────────────────────────────────────────────────

# FreeCustom.Email (provider=fce, miễn phí, đăng ký tại https://www.freecustom.email/auth)
FCE_API_KEY=""

# Outlook +tag alias (provider=outlook, XOAUTH2 IMAP đọc trực tiếp)
# OUTLOOK_ACCOUNTS="your@outlook.com,another@hotmail.com"
# OUTLOOK_TOKENS_FILE="outlook_tokens.json"

# Gmail IMAP (provider=gmail, dùng +alias để tạo email phái sinh)
GMAIL_BASE_EMAIL=""
GMAIL_APP_PASSWORD=""

# Số luồng đăng ký song song (tuỳ chọn)
THREADS="1"

# LuckMail (provider=luckmail, trả phí)
# LUCKMAIL_BASE_URL đã mặc định là https://mails.luckyous.com
# LUCKMAIL_BASE_URL="https://mails.luckyous.com"
LUCKMAIL_API_KEY="your_luckmail_api_key"
LUCKMAIL_API_SECRET=""
LUCKMAIL_USE_HMAC="false"
LUCKMAIL_PROJECT_CODE="grok"
LUCKMAIL_EMAIL_TYPE="ms_imap"
LUCKMAIL_DOMAIN="outlook.com"

# MailNest (provider=mailnest, trả phí)
# Lấy API key: https://mailnest.top/account
# Lấy mã dự án: https://mailnest.top/buy-email (mặc định x-ai001)
MAILNEST_API_KEY="your_mailnest_api_key"
MAILNEST_PROJECT_CODE="x-ai001"

# ──────────────────────────────────────────────────────────────
# Proxy (tuỳ chọn)
# ──────────────────────────────────────────────────────────────

# Proxy HTTP/HTTPS chung
# HTTP_PROXY="http://127.0.0.1:7890"
# HTTPS_PROXY="http://127.0.0.1:7890"

# Proxy Clash cho đăng ký / mint token (grok.py, sso_to_cpa.py)
# GROK_PROXY="http://127.0.0.1:7897"

# Proxy nhà dân thực (device_consent.py / poll_tokens.py cần, không có sẽ báo lỗi)
# CLIPROXY=""

# Thư mục xuất CPA auths (mặc định D:\CLIProxyAPIPlus\auths)
# CPA_AUTHS_DIR=""

# Clash External Controller (clash_rotator.py)
# CLASH_SECRET=""
# CLASH_PROXY_GROUP="your_group_name"

# remint_oauth.py — danh sách email cần re-mint (phân cách bằng dấu phẩy)
# REMINT_EMAILS=""
